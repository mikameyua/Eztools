<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Eztools.Cli</RootNamespace>
    <!-- 可执行文件名就是命令名：ezt -->
    <AssemblyName>ezt</AssemblyName>
    <RollForward>LatestMajor</RollForward>

    <!--
      W4-a（2026-09-25，设计方案 §6 修订）：从 net10.0 升到带 SDK 版本的 windows TFM。
      原因：本项要引用 Eztools.Ocr（TFM net10.0-windows10.0.19041.0），低 TFM 引用不了高 TFM。
      影响：① 输出路径 bin/Debug/<此TFM>，acceptance.sh / budget.sh / 探针脚本的 TFM 默认值已同步改；
            ② 本项目仍是控制台 Exe（OutputType 未动），不引入 UI 栈。
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <!--
    发布形态：自包含 · 非单文件 · 非裁剪（理由与 Desktop 相同，见其csproj 注释）。
    固化在此而非只写在 make-portable.sh 的命令行上 —— 否则任何人直接
    `dotnet publish` 都会拿到框架依赖产物，在开发机上跑得好好的，
    发给没有 .NET 的用户才炸。
  -->
  <PropertyGroup Condition="'$(IsPublishing)' == 'true' or $([System.String]::Copy('$(Configuration)').StartsWith('Release'))">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eztools.Ocr\Eztools.Ocr.csproj" />
    <!--
      W5-a（2026-09-26）：剪贴板历史库原语层。`ezt clip *` 全子命令与 selftest
      的存储结构用例都走它（S9 同族：协议/存储断言不依赖真进程）。
    -->
    <ProjectReference Include="..\Eztools.Clipboard\Eztools.Clipboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eztools.Host\Eztools.Host.csproj" />
    <!--
      Wave 3（W3-a-1）：索引进程随解决方案一起构建。
      引用它有两个目的：① ezt-index.exe / .dll / Eztools.Contracts.dll 一并落到本项目的 bin/，
      `ezt install` 的 bin/ 复制与 make-portable.sh 天然带上（验收③⑤）；
      ② `ezt selftest` 直接实例化 IndexRpcServer（StringReader/StringWriter），
      让 BOM 容忍 / ping 字段 / 错误码这些协议断言不依赖真进程就能跑（S9 同族防御）。
    -->
    <ProjectReference Include="..\Eztools.Index\Eztools.Index.csproj" />
  </ItemGroup>

  <!--
    P0 的可运行入口。
    刻意先做 CLI 而不是 WinUI：
      · P0 的验收标准是"新增工具目录 → 宿主自动发现可用"，这件事与 UI 无关
      · 本机未安装 WindowsAppRuntime（WinUI 3 依赖），P0 不该被 UI 依赖阻塞
      · CLI 是验收测试最可靠的载体——可脚本化、可断言、可进 CI
    P1 的 WinUI 设置应用会直接引用同一个 Eztools.Host，两者只是同一门面的不同前端。
  -->

</Project>
