{
  "id": "wordcount",
  "name": "文本统计",
  "version": "0.2.0",
  "description": "统计文本的字符数、词数、行数，支持直接读文件",
  "author": "Eztools",
  "license": "GPL-3.0-or-later",
  "runtime": "python",
  "runtimeVersion": ">=3.11",
  "entry": "main.py",
  "weight": "lite",
  "lifecycle": "transient",
  "needs": ["files.userSelected", "notify"],
  "contributes": {
    "commands": [
      { "id": "wordcount.count", "title": "统计文本", "handler": "count", "description": "统计传入文本的字符/词/行数" },
      { "id": "wordcount.countFile", "title": "统计文件", "handler": "countFile", "description": "读取文件并统计" }
    ],
    "actions": [
      {
        "id": "wordcount.action.countFile",
        "title": "统计选中的文本文件",
        "when": "files.ext:txt,md,py,json,csv",
        "handler": "countFile"
      }
    ],
    "hotkeys": [
      { "command": "wordcount.count", "default": "Ctrl+Alt+N", "title": "统计剪贴板文本" }
    ],
    "menus": [
      { "location": "tray", "command": "wordcount.count", "group": "text", "input": "clipboard" }
    ]
  },
  "config": {
    "type": "object",
    "properties": {
      "countWhitespace": {
        "type": "boolean",
        "default": false,
        "title": "把空白字符计入字符数",
        "description": "关闭时只统计非空白字符"
      },
      "language": {
        "type": "string",
        "default": "auto",
        "title": "分词方式",
        "enum": ["auto", "cjk", "latin"]
      },
      "maxFileSizeMb": {
        "type": "integer",
        "default": 64,
        "minimum": 1,
        "maximum": 1024,
        "title": "最大读取文件大小 (MB)"
      }
    }
  }
}
