{
  "id": "echo",
  "name": "回显",
  "version": "0.2.0",
  "description": "把输入原样回显，用于验证协议往返、UTF-8 编码与大 payload",
  "author": "Eztools",
  "license": "GPL-3.0-or-later",
  "runtime": "python",
  "runtimeVersion": ">=3.11",
  "entry": "main.py",
  "weight": "lite",
  "lifecycle": "transient",
  "needs": [],
  "contributes": {
    "commands": [
      {
        "id": "echo.echo",
        "title": "回显文本",
        "handler": "echo",
        "description": "返回输入文本与其长度"
      },
      {
        "id": "echo.large",
        "title": "生成大 payload",
        "handler": "large",
        "description": "生成指定大小的文本，用于验证分帧不截断"
      }
    ]
  },
  "config": {
    "type": "object",
    "properties": {
      "uppercase": {
        "type": "boolean",
        "default": false,
        "title": "转为大写",
        "description": "回显前把文本转成大写"
      }
    }
  },
  "configHidden": true
}
