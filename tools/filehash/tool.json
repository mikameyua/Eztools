{
  "id": "filehash",
  "name": "文件校验",
  "version": "0.1.0",
  "description": "计算文件的哈希值，用于校验下载文件是否损坏或被篡改",
  "author": "菲比",
  "runtime": "python",
  "runtimeVersion": ">=3.11",
  "entry": "main.py",
  "weight": "lite",
  "lifecycle": "transient",
  "needs": ["files.userSelected"],
  "contributes": {
    "commands": [
      { "id": "filehash.hash", "title": "计算文件哈希", "handler": "hash", "description": "对单个文件计算哈希" },
      { "id": "filehash.hashMany", "title": "批量计算文件哈希", "handler": "hashMany", "description": "对多个文件依次计算哈希" }
    ],
    "actions": [
      {
        "id": "filehash.action.hashFile",
        "title": "校验文件哈希",
        "when": "files.count>=1",
        "handler": "hashMany"
      }
    ],
    "hotkeys": [
      { "command": "filehash.hash", "default": "Ctrl+Alt+H" }
    ],
    "menus": [
      { "location": "tray", "command": "filehash.hashMany", "group": "file", "input": "clipboard" }
    ]
  },
  "config": {
    "type": "object",
    "properties": {
      "algorithm": {
        "type": "string",
        "default": "sha256",
        "title": "默认算法",
        "enum": ["sha256", "sha1", "md5", "blake2b"]
      },
      "uppercase": {
        "type": "boolean",
        "default": false,
        "title": "输出大写十六进制"
      },
      "chunkSizeKb": {
        "type": "integer",
        "default": 1024,
        "minimum": 4,
        "maximum": 65536,
        "title": "分块大小 (KB)",
        "description": "大文件按分块读取，避免一次性载入内存"
      }
    }
  }
}
